# Copy to .env and fill in ONE provider key. Never commit .env.

# --- FREE options (pick one) ---
# Google AI Studio: https://aistudio.google.com/apikey   (no card needed)
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (use a model ending in :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub Models (free with a GitHub PAT): https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# --- PAID ---
ANTHROPIC_API_KEY=

# --- Telegram delivery (free) ---
# Create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ---
# SUBTEXT_PROVIDER=gemini      # force a provider
# SUBTEXT_MODEL=               # override the default model
# SUBTEXT_CACHE_DIR=./data/cache
